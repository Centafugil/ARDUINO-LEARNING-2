

const int sensor = 8;
const int buzzer = 9;
const int led =  10;




void setup(){
  pinMode(sensor, INPUT);
  pinMode(buzzer, OUTPUT);
  pinMode(led, OUTPUT);
  Serial.begin(9600);
}


unsigned long motionTime;
bool ledOn = false;
bool motionDetected;

bool firstLoop = true;

void loop(){
    
    if(firstLoop){
        warmUpSequence();
    }

   

    motionDetected = digitalRead(sensor);

    if(motionDetected && !ledOn){
        digitalWrite(led, HIGH);
        tone(buzzer, 1000);
        motionTime = millis();
        ledOn = true;

        Serial.println("Motion detected");
    }
    
    if(ledOn && millis() - motionTime >= 5000){
        digitalWrite(led, LOW);
        ledOn = false;
        noTone(buzzer);
        Serial.println("5 sec passed away");
    }
    
    firstLoop = false;
}

void warmUpSequence(){
   
  while(millis() < 60000){
        digitalWrite(led, HIGH);
        delay(1000);
        digitalWrite(led, LOW);
        delay(1000);
        Serial.println("pleaseWait");
  }
    Serial.println("ready to use");
}