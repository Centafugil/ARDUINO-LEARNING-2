void setup(){
  pinMode(9, OUTPUT);
  pinMode(10, OUTPUT);
  pinMode(11, OUTPUT);
  Serial.begin(9600);
}

const int sensor = 9;
const int led = 10;
const int buzzer = 11;



bool motionDetected;

void loop(){
	
    motionDetected = digitalRead(sensor);

    if(motionDetected){
        digitalWrite(led, HIGH);
        tone(buzzer, 1000);
        delay(500);
        Serial.println("Detected");
    }
    else{
        notone(buzzer);
        digitalWrite(led, LOW);
        Serial.println(" nope Detected");
    }

    

}